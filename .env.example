# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://focalinc.com.br
NEXT_PUBLIC_GA_ID=

# CTAs de WhatsApp passam por /ir/whatsapp (registro no servidor antes do
# redirect). Custa um salto a mais e exige servidor; sem isso o clique é
# registrado por sendBeacon, que pode ser descartado na navegação.
NEXT_PUBLIC_WHATSAPP_REDIRECT=0

# ─────────────────────────────────────────────────────────────
# Armazenamento do warehouse de atribuição
#   Supabase (recomendado): leitura e escrita, e o cliente pode plugar
#   Looker Studio direto no Postgres. Sem nenhuma das duas opções abaixo, o
#   pipeline roda em memória e perde tudo no restart.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Alternativa para ambiente próprio/dev: arquivos JSONL num diretório.
ATRIBUICAO_ARQUIVO=

# Espelho write-only de toda gravação (n8n, Make, Apps Script). Opcional.
LEAD_WEBHOOK_URL=

# Protege /relatorios/roas. Sem token a página fica aberta a quem souber a URL.
RELATORIO_TOKEN=

# ─────────────────────────────────────────────────────────────
# CVCRM  (Painel > Configurações > Usuários Administrativos > Token)
#   Permissões necessárias no perfil do usuário de integração:
#   "Cadastrar Novo Lead", "Administrar lead", "Administrar reservas".
# ─────────────────────────────────────────────────────────────
CVCRM_BASE_URL=https://SUBDOMINIO.cvcrm.com.br
CVCRM_EMAIL=
CVCRM_TOKEN=
# CVDW é o data warehouse do CV — módulo contratado à parte. Sem ele a
# sincronização usa os endpoints transacionais, que não filtram por data de
# alteração e por isso varrem muito mais.
CVCRM_CVDW=0
# Segredo do webhook (o CV não assina os disparos): use alta entropia e
# cadastre a URL como .../api/webhooks/cvcrm?k=SEGREDO
CVCRM_WEBHOOK_SEGREDO=
# idempreendimento do Artur 73 no CV (opcional).
CVCRM_ID_EMPREENDIMENTO=
# IDs de situação do workflow que contam como qualificado/venda. Descubra com
# GET /api/v1/configuracoes/workflows/leads e .../reservas.
CVCRM_SITUACOES_QUALIFICADO=
CVCRM_SITUACOES_VENDA=
# Slugs reais dos campos adicionais, se forem diferentes do padrão.
# CVCRM_CAMPO_REF=lead_ref
# CVCRM_CAMPO_GCLID=gclid

# ─────────────────────────────────────────────────────────────
# Google
#   Custo: Google Ads API (exige developer token).
#   Conversões offline: Data Manager API (NÃO exige developer token).
#   O mesmo refresh token serve para as duas se foi emitido com os escopos
#   .../auth/adwords e .../auth/datamanager.
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Ou um por API, se preferir separar:
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_DATAMANAGER_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Obrigatório quando o acesso à conta é via MCC da agência.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# IDs numéricos das conversion actions (tipo "Importar de cliques").
GOOGLE_CONVERSION_QUALIFICADO=
GOOGLE_CONVERSION_VISITA=
GOOGLE_CONVERSION_PROPOSTA=
GOOGLE_CONVERSION_VENDA=

# ─────────────────────────────────────────────────────────────
# Meta
#   Token de system user do Business Manager, com ads_read no mínimo.
#   O token da Conversions API sai em Events Manager > Dataset >
#   Configurações > Conversions API > Gerar token de acesso.
# ─────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_DATASET_ID=
# ID da conta do WhatsApp Business, para eventos de clique-para-WhatsApp.
META_WABA_ID=

# ─────────────────────────────────────────────────────────────
# Valores-proxy das etapas de meio de funil, em reais.
#   Servem para o Smart Bidding otimizar por valor esperado sem esperar a
#   venda (que não cabe nas janelas das plataformas).
#   Fórmula: ticket médio × taxa histórica da etapa até a venda.
#   Ex.: R$ 2.054.000 × 2% = 41.000 para lead qualificado.
# ─────────────────────────────────────────────────────────────
ROAS_VALOR_QUALIFICADO=
ROAS_VALOR_VISITA=
ROAS_VALOR_PROPOSTA=
